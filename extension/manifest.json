{
  "manifest_version": 3,
  "name": "Part Risk Badge",
  "version": "1.0.0",
  "description": "Shows supply-shortage risk next to part numbers on any page.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "css": ["badge.css"], "run_at": "document_idle" }
  ],
  "options_page": "options.html"
}
